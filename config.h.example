// config.h.example - copy this file to config.h and fill in your own values.
// config.h is .gitignore'd so your secrets never leave your machine.

#pragma once

// --- WiFi -------------------------------------------------------------------
#define WIFI_SSID      "your-wifi-ssid"
#define WIFI_PASSWORD  "your-wifi-password"

// --- MQTT broker ------------------------------------------------------------
// Public test broker (no auth): "test.mosquitto.org", port 1883
// HiveMQ public: "broker.hivemq.com", port 1883
// Self-hosted: your broker host/IP
#define MQTT_HOST        "broker.hivemq.com"
#define MQTT_PORT        1883
#define MQTT_CLIENT_ID   "fluidwire-esp32-fan"
#define MQTT_USER        ""        // leave blank for anonymous brokers
#define MQTT_PASSWORD    ""

// --- Topics -----------------------------------------------------------------
// Publish an integer percent (0..100) to the command topic -- RETAINED, so the
// board picks it back up after a reboot. The device echoes the percent it
// actually applied (retained) to the state topic and, if the fan has a tach
// wire, its RPM to the rpm topic every few seconds.
#define MQTT_CMD_TOPIC    "fluidwire/demo/fan/cmd"
#define MQTT_STATE_TOPIC  "fluidwire/demo/fan/state"
#define MQTT_RPM_TOPIC    "fluidwire/demo/fan/rpm"
